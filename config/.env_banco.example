# Money — banco di prova a secco: segreti del nodo (chiave dedicata READ-ONLY).
# MAI in git: copiare in config/.env_banco, riempire, chmod 600.
#
# IL PROPRIETARIO DEVE CREARE QUESTA CHIAVE (azione di conto):
# - Permessi: SOLO Read (niente trade, niente withdraw: la main puo' PRELEVARE)
# - IP Whitelist: 87.106.222.123 (MARCODG1); 87.106.3.15 (nuvola, solo se il
#   banco gira anche li')
# - Hostname: eea.okx.com (le chiavi EU falliscono altrove con 50119, che
#   SEMBRA una chiave morta)
#
# Con una chiave read-only "nessun ordine" e' una proprieta' della credenziale,
# non una convenzione nel codice. Il codice non ha percorsi di invio (guardia
# statica in deploy/tests/, eseguita dalla CI a ogni push). Se OKX non
# permettesse una read-only pura per gli endpoint necessari, si ripiega sulla
# main — e la guardia statica resta OBBLIGATORIA, non opzionale.

OKX_API_KEY=DA_CREARE_DAL_PROPRIETARIO
OKX_API_SECRET=DA_CREARE_DAL_PROPRIETARIO
OKX_PASSPHRASE=DA_CREARE_DAL_PROPRIETARIO
OKX_HOSTNAME=eea.okx.com

# Con la chiave dedicata in uso, scommentare: il banco RIFIUTA (exit 5) una
# chiave che possa commerciare o prelevare.
#BANCO_RICHIEDI_READ_ONLY=1

# Dove scrivere il file health (default: PROJECT_ROOT/logs/banco_secco_health.json;
# i path relativi partono da PROJECT_ROOT). Se punta fuori da PROJECT_ROOT/logs,
# aggiungere il path a ReadWritePaths con un drop-in (systemctl edit).
#BANCO_HEALTH_PATH=/home/marco/denaro/health/banco_secco.json

# Capitale dichiarato, simbolo, frazione e min_notional stanno in
# config/node_banco.yaml (configurazione VERSIONATA, spec §3): non si
# sovrascrivono da qui.
