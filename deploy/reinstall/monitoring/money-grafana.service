[Unit]
Description=Grafana (money) — MARCODG1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=marco
WorkingDirectory=/home/marco/denaro
Environment=GF_SECURITY_ADMIN_USER=admin
Environment=GF_SECURITY_ADMIN_PASSWORD=__GRAFANA_ADMIN_PASS__
Environment=GF_USERS_ALLOW_SIGN_UP=false
Environment=GF_SERVER_ROOT_URL=https://grafana.grivetto.eu
Environment=GF_SERVER_DOMAIN=grafana.grivetto.eu
Environment=GF_SERVER_HTTP_ADDR=127.0.0.1
Environment=GF_SERVER_HTTP_PORT=3000
Environment=GF_PATHS_PROVISIONING=/home/marco/denaro/grafana/provisioning
Environment=GF_PATHS_DATA=/home/marco/denaro/grafana-data
Environment=GF_PATHS_HOME=/home/marco/denaro/grafana
Environment=GF_AUTH_ANONYMOUS_ENABLED=true
Environment=GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
Environment=GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/home/marco/denaro/grafana-data/dashboards/denaro-dashboard.json
Environment=GF_SECURITY_ALLOW_EMBEDDING=true
Environment=GF_ANALYTICS_REPORTING_ENABLED=false
Environment=GF_ANALYTICS_CHECK_FOR_UPDATES=false
Environment=GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
ExecStart=/home/marco/denaro/grafana/bin/grafana server --homepath=/home/marco/denaro/grafana
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
