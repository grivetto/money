# Money - Health Server MARCODG1 (:8911) — migrato da denaro-health-marcodg1 (2026-10-06)
[Unit]
Description=Money - Health Server MARCODG1 (:8911)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=marco
WorkingDirectory=/home/marco/money
ExecStart=/usr/bin/python3 /home/marco/money/ops/health/health_server_marcodg1.py
Environment=HEALTH_DIR=/home/marco/denaro/health
Environment=HEALTH_PORT=8911
Environment=HEALTH_HOST=127.0.0.1
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
