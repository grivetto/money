# Money - Banco di prova a secco (DRY-RUN) — versione money (2026-10-06, casa unica)
[Unit]
Description=Money — Banco di prova a secco (pre-produzione, DRY-RUN)
Documentation=https://github.com/grivetto/money/blob/main/docs/02_banco_di_prova_a_secco.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/marco/money/deploy/scripts/money_banco_secco.sh
WorkingDirectory=/home/marco/money
User=marco
Group=marco
Environment="MONEY_SRC=/home/marco/money/src"
SuccessExitStatus=2
StandardOutput=journal
StandardError=journal

# Hardening: nessun privilegio, filesystem in sola lettura tranne logs/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/marco/money/logs
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
