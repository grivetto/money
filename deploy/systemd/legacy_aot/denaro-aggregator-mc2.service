# /etc/systemd/system/denaro-aggregator-mc2.service
# /etc/systemd/system/denaro-aggregator-mc2.service
# Denaro - Infra Aggregator mc2 (:8912)
# Alimenta la dashboard (:8913) e /api/infra.json.
# ExecStartPre: port_guard.sh termina le copie ESTRANEE dell'aggregator (avviate
# a mano) che tengono la 127.0.0.1:8912.
# 2026-09-25: consolidati i path canonici del repo (~/alpha-omega-trading) e il
# venv del repo; HEALTH_DIR ora nella unit (prima era un drop-in con path morto).
[Unit]
Description=Denaro - Infra Aggregator mc2 (:8912, alimenta dashboard)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=sergio
WorkingDirectory=/home/sergio/alpha-omega-trading
ExecStartPre=/bin/bash /home/sergio/alpha-omega-trading/denaro/scripts/port_guard.sh denaro-aggregator-mc2.service infra_aggregator.py 8912
ExecStart=/home/sergio/alpha-omega-trading/venv/bin/python /home/sergio/alpha-omega-trading/denaro/infra_aggregator.py
Environment=HEALTH_DIR=/home/sergio/denaro/health
Environment=NODE_DIR=/home/sergio/alpha-omega-trading/node_data
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
