[Unit]
Description=DSH (DeepSeek Harness) — Web UI · omarchy (accesso via tunnel ssh)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sergio
Group=sergio
WorkingDirectory=/home/sergio
Environment=HOME=/home/sergio
Environment=PATH=/home/sergio/.local/share/mise/installs/node/26.8.1/bin:/home/sergio/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/sergio/.local/share/mise/installs/node/26.8.1/bin/node /home/sergio/.local/share/mise/installs/node/26.8.1/lib/node_modules/@deepseek-ai/dsh/lib/bin.js web --no-open --host 192.168.1.98 --port 5080 --trusted-host omarchy --trusted-host omarchy:5080 --trusted-host omarchy.local --trusted-host omarchy.local:5080 --trusted-host 192.168.1.98 --trusted-host 192.168.1.98:5080 --trusted-host mc2.tail1b5252.ts.net:8446
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
SyslogIdentifier=dsh-web

[Install]
WantedBy=multi-user.target
