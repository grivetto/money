[Unit]
Description=DSH (DeepSeek Harness) — Web UI · omarchy (accesso via tunnel ssh)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sergio
Group=sergio
WorkingDirectory=/home/sergio
Environment=HOME=/home/sergio
Environment=PATH=/home/sergio/.local/share/mise/installs/node/26.8.1/bin:/home/sergio/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/sergio/.local/share/mise/installs/node/26.8.1/bin/node /home/sergio/.local/share/mise/installs/node/26.8.1/lib/node_modules/@deepseek-ai/dsh/lib/bin.js web --no-open --port 3080 --trusted-host omarchy --trusted-host omarchy:3080 --trusted-host omarchy.local --trusted-host omarchy.local:3080 --trusted-host 192.168.1.98 --trusted-host 192.168.1.98:3080
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
SyslogIdentifier=dsh-web

[Install]
WantedBy=multi-user.target
