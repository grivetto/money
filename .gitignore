# Il progetto riscritto da zero
data/
*.db

# Ambiente
venv/
.env
__pycache__/
*.py[cod]
.pytest_cache/
.pytmp/
.ruff_cache/

# Output grezzi dei runner di misura.
# Le prove curate stanno in prove/ e sono versionate: queste cartelle no, perche' chi
# riproduce una misura da un clone pulito non deve trovarsi git status sporco.
risultati/
report/
dati_cache/

# Nota sull'ambiente (Windows + sandbox): 	tempfile.mkdtemp e le directory appena
# create non sono scrivibili. Per questo i test usano cartella_temporanea() sotto
# .pytmp/ e le cache degli strumenti restano qui dentro invece che in %TEMP%.
.venv/
logs/

# segreti banco (casa unica money, 2026-10-06)
config/.env_banco
!config/.env_banco.example
prove/funding_watch/

# pannello agenti: JSON generato dal cron (ops/agents/agents_status.py) — non versionare
ops/dashboard/agenti.json

# scommessa asimmetrica: JSON generato dal cron (ops/tools/scommessa.py) — non versionare
ops/dashboard/scommessa.json

# build artifacts
*.egg-info/

# artefatti operativi locali (non codice)
publish.log
*.bak-*
.venv-onchain/
ops/dashboard/airdrop_status.json
ops/dashboard/landing.live-*.html
